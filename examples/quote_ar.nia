# نفس المقايسة بالكلمات العربي والأرقام الهندية. الأسعار توضيحية.

ليكن سعر_المتر = {بيت: ٣٥٠٠, شقة: ٣٠٠٠, تجاري: ٤٥٠٠}

دالة مقايسة(مساحة: رقم في ٣٠..١٠٠٠, ادوار: عدد في ١..١٠, نوع: "بيت" | "شقة" | "تجاري") -> رقم
  اضمن ناتج > ٠
  اضمن ناتج <= مساحة * ادوار * ٨٠٠٠
  مثال (١٨٠, ٢, "بيت") -> ١٢٦٠٠٠٠
  مثال (مساحة: ١٢٠, ادوار: ٣, نوع: "شقة") -> ١١٠٠٠٠٠ ± ٥٪
{
  مساحة * ادوار * سعر_المتر[نوع]
}

اطبع("مقايسة بيت ١٨٠ متر دورين:", مقايسة(١٨٠, ٢, "بيت"), "جنيه")
